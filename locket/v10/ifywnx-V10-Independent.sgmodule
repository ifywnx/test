[Script]
locket_v10_captions = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v10/Locket_V10_Captions.js, requires-body=true, max-size=524288, timeout=60

[MITM]
hostname = %APPEND% firebaseremoteconfig.googleapis.com
