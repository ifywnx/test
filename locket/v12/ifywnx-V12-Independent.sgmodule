#!name=ifywnx V12 Unified
#!desc=Camera 60s, micro, captions, widget. Upload 60s chưa xác nhận trên thiết bị.
#!category=Rewrite
#!system=iOS

[Script]
# 1. Ép xóa ETag & Cache (Bảo vệ Mod Gold không bị văng)
Locket_Cache_Buster = type=http-request, pattern=^https?:\/\/(api\.revenuecat\.com\/.+\/(receipts|subscribers)|firebaseremoteconfig\.googleapis\.com\/.*), script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v12/deleteHeader.js, timeout=60

# 2. Cấp quyền Locket Gold VIP vĩnh viễn qua RevenueCat (Non-Sandbox)
Locket_Gold_Unlock = type=http-response, pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v12/Locket_ifywnx.js, requires-body=true, max-size=524288, timeout=60

# 3. Remote Config: camera, caption, widget
Locket_Captions_Frames = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v12/Locket_Unlocked.js, requires-body=true, max-size=524288, timeout=60

[MITM]
hostname = %APPEND% *.revenuecat.com, api.revenuecat.com, firebaseremoteconfig.googleapis.com
