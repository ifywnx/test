#!name=IFYWNX V11 Pro - Locket Gold & Captions
#!desc=Mở khóa Locket Gold VIP vĩnh viễn, Khung Widget tùy biến, Overlays và Dynamic Captions (Auto Anti-Cache & Zero Crash).
#!category=Rewrite
#!system=iOS
#!url=https://raw.githubusercontent.com/ifywnx/test/main/locket/v11/ifywnx-V11-Independent.sgmodule

[Script]
# 1. Ép triệt tiêu cache headers (x-revenuecat-etag, if-none-match) để ép server trả về mã 200 OK
locket_cache_buster = type=http-request, pattern=^https?:\/\/(api\.revenuecat\.com\/.+\/(receipts|subscribers)|firebaseremoteconfig\.googleapis\.com\/.*), script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v11/deleteHeader.js, timeout=60

# 2. Cấp quyền Locket Gold VIP, mở khóa full entitlements & non-subscriptions
locket_gold_unlock = type=http-response, pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v11/Locket_ifywnx.js, requires-body=true, max-size=524288, timeout=60

# 3. Kích hoạt Feature Gates, Khung Shin-chan & toàn bộ kho Captions độc quyền
locket_captions_unlock = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v11/Locket_Unlocked.js, requires-body=true, max-size=524288, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, *.revenuecat.com, firebaseremoteconfig.googleapis.com
