#!name=IFYWNX-V11-Independent
#!desc=3-script independent GitHub experiment; use instead of Config V11
#!url=https://raw.githubusercontent.com/ifywnx/test/main/locket/v11/ifywnx-V11-Independent.sgmodule

[Script]
locket_sub_readonly = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v11/Locket_ifywnx.js, requires-body=true, max-size=524288, timeout=60
locket_header_readonly = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v11/deleteHeader.js, timeout=60
locket_v11_captions = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/ifywnx/test/main/locket/v11/Locket_Unlocked.js, requires-body=true, max-size=524288, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
